# ========================================================
# ResQMesh AI - Git Ignore Configuration
# ========================================================

# Dependencies
node_modules/
*/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment Variables & Secrets (NEVER COMMIT)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
backend/.env
frontend/.env
*.env
# Ensure example config files ARE committed
!.env.example
!backend/.env.example
!frontend/.env.example

# Build Outputs
dist/
dist-ssr/
frontend/dist/
build/
*.local

# Database & Runtime State (Keep directory via .gitkeep, ignore data files)
backend/data/*.json
backend/data/*.tmp
backend/data/*.db
!backend/data/.gitkeep
*.sqlite
*.sqlite3

# Logs & Temporary Files
*.log
*.tmp
*.temp

# Operating System Files
.DS_Store
Thumbs.db
desktop.ini

# IDE & Editor Settings
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
